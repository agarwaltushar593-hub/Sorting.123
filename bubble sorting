#include <stdio.h>
#include<stdbool.h>
int main() {
 int n=5;
 int a[5]= {2,4,30,8,1};
    for(int i=0;i<=n-1;i++){
        bool flag=false;
        for(int j=0;j<=n-2;j++){
            if(a[j]>a[j+1]){
                int temp=a[j];
                a[j]=a[j+1];
                a[j+1]=temp;
                flag=true;
            }
        }
        if(flag==false ){
        break;
        }
    }
    for (int i=0;i<=n-1;i++){
        printf("%d ",a[i]);
    }
    return 0;
}
